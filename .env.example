# L'app lit DB_RONVEAU_DATABASE_URL, puis DATABASE_URL, puis POSTGRES_URL.
# drizzle-kit utilise DB_RONVEAU_POSTGRES_URL_NON_POOLING s'il est défini.
# ADMIN_PASSWORD : mot de passe de /admin/connexion. Vide = connexion refusée.
# BILLETTERIE_OUVERTE : passer à true seulement pour afficher le formulaire public d'inscription.

DATABASE_URL=
ADMIN_PASSWORD=
BILLETTERIE_OUVERTE=false

# Clés Mailjet : compte Mailjet → Account settings → API Key Management (API Key et Secret Key).
# L'adresse d'expéditeur doit être un expéditeur validé dans Mailjet.
# Elles servent à l'e-mail de confirmation envoyé après une préinscription.
# Si les clés sont vides, la préinscription est quand même enregistrée.

MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAILJET_FROM_EMAIL=contact@lematchduronvau.be
MAILJET_FROM_NAME=Le Match du Ronvau
